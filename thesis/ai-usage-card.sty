% -------------------------------------------------------------------
%              GENERAL SECTION VISIBILITY HELPER
% -------------------------------------------------------------------
% Single reusable toggle – reset before each section check
\newtoggle{ai@secvis}

% Helper: if a field is defined and non-blank, set ai@secvis to true
\newcommand{\ai@checkfield}[1]{% #1 = internal field name (e.g. @aiModels)
  \expandafter\ifx\csname #1\endcsname\relax\else
    \expandafter\ifblank\expandafter{\csname #1\endcsname}{}{\toggletrue{ai@secvis}}%
  \fi
}

% \ai@ifsectionused{<comma-separated field names>}{<true>}{<false>}
% Renders #2 when at least one listed field is defined and non-blank,
% otherwise renders #3.  Works for any number of fields.
\newcommand{\ai@ifsectionused}[3]{%
  \togglefalse{ai@secvis}%
  \forcsvlist{\ai@checkfield}{#1}%
  \iftoggle{ai@secvis}{#2}{#3}%
}

% -------------------------------------------------------------------
%              OXFORD COMMA LIST FORMATTER (expl3)
% -------------------------------------------------------------------
% If a field value is a comma-separated list with >2 items and does
% not already contain " and ", insert ", and" before the last item.
%   Input:  "A, B, C"       → Output: "A, B, and C"
%   Input:  "A, B"          → Output: "A, B"          (unchanged, ≤2)
%   Input:  "A, B, and C"   → Output: "A, B, and C"   (unchanged, has "and")
%   Input:  "Some sentence" → Output: "Some sentence"  (unchanged, ≤1)

\ExplSyntaxOn

\tl_new:N  \l__ai_input_tl
\seq_new:N \l__ai_items_seq
\seq_new:N \l__ai_trimmed_seq

\cs_new_protected:Nn \__ai_format_list:n
{
  \tl_set:Nn \l__ai_input_tl {#1}
  % If " and " already present, output as-is
  \tl_if_in:NnTF \l__ai_input_tl {~and~}
  { #1 }
  {
    \seq_set_split:Nnn \l__ai_items_seq {,} {#1}
    \int_compare:nTF { \seq_count:N \l__ai_items_seq > 2 }
    {
      % Trim whitespace from each item
      \seq_clear:N \l__ai_trimmed_seq
      \seq_map_inline:Nn \l__ai_items_seq
      {
        \tl_set:Nn \l_tmpa_tl {##1}
        \tl_trim_spaces:N \l_tmpa_tl
        \seq_put_right:NV \l__ai_trimmed_seq \l_tmpa_tl
      }
      % Rejoin: "A, B, and C"
      %   2-item sep (unused here since count>2): ", "
      %   middle sep: ", "
      %   final sep:  ", and "
      \seq_use:Nnnn \l__ai_trimmed_seq {,~} {,~} {,~and~}
    }
    { #1 } % ≤2 items: output unchanged
  }
}

% LaTeX2e wrapper
\NewDocumentCommand \aiFormatList { m }
{
  \__ai_format_list:n {#1}
}

\ExplSyntaxOff

