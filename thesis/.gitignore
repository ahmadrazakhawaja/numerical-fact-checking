# ---------------------------------------------------------------
# Build output
# ---------------------------------------------------------------
# The Makefile writes every intermediate file (.aux, .log, .toc, .bbl,
# and the Inkscape SVG cache) into build/, so the source folder stays
# clean. Ignore the whole directory.
build/

# ---------------------------------------------------------------
# LaTeX build artifacts (kept below as a safety net if you ever run
# pdflatex directly, without -output-directory) (regenerated by pdflatex/bibtex on compile)
# ---------------------------------------------------------------

# Core auxiliary files
*.aux
*.log
*.out
*.toc
*.lof
*.lot
*.fls
*.fdb_latexmk
*.synctex.gz
*.synctex(busy)
*.pdfsync

# Bibliography
*.bbl
*.blg
*.bcf
*.run.xml
*-blx.bib

# Index / glossary / nomenclature
*.idx
*.ilg
*.ind
*.glo
*.gls
*.glg
*.nlo
*.nls
*.acn
*.acr
*.alg
*.ist

# Hyperref / cleveref / todonotes
*.brf
*.tdo

# Beamer / listings / misc
*.nav
*.snm
*.vrb
*.xdv

# svg package: Inkscape-generated PDF+TeX fragments
svg-inkscape/
*_svg-tex.pdf
*_svg-tex.pdf_tex
*_svg-raw.pdf

# latexmk / arara
*.latexmk
.latexmkrc.local

# Compiled output — uncomment the next line if you prefer NOT to
# commit the built PDF. It is committed by default so supervisors
# can read the current draft straight from the repository.
# 00_main.pdf

# Editor / OS cruft
.DS_Store
._*
*.swp
*~
.vscode/
.idea/
